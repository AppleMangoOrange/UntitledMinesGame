[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../mines_core/target/debug/libmines_core.so"
linux.release.x86_64 = "res://../mines_core/target/release/libmines_core.so"
windows.debug.x86_64 = "res://../mines_core/target/debug/mines_core.dll"
windows.release.x86_64 = "res://../mines_core/target/release/mines_core.dll"
macos.debug = "res://../mines_core/target/debug/libmines_core.dylib"
macos.release = "res://../mines_core/target/release/libmines_core.dylib"
